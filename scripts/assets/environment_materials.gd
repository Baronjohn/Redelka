class_name EnvironmentMaterials
extends RefCounted

## Explore-scene materials built from the tiling textures in assets/textures/explore/
## (generated by tools/generate_textures.py). Textures are mapped in world space
## (triplanar), so a surface of any size keeps the same texel density: one texture tile
## covers `tile_m` metres. Scenes generated by tools/generate_scenes.py carry their own
## materials; the per-area themes below only dress older scenes' untextured floors and walls.

const TEXTURE_DIR: String = "res://assets/textures/explore"
const DEFAULT_FLOOR_TILE: float = 2.0
const DEFAULT_WALL_TILE: float = 2.5

static var _textures: Dictionary = {}


class AreaTheme:
	var floor_texture: String = "flagstone"
	var floor_tint: Color = Color(1, 1, 1)
	var wall_texture: String = "plaster"
	var wall_tint: Color = Color(1, 1, 1)


## A world-mapped material for one of the generated textures, e.g. ("boards", tint, 1.2).
static func world_material(texture_name: String, tint: Color = Color(1, 1, 1), tile_m: float = DEFAULT_FLOOR_TILE) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_texture = get_texture(texture_name)
	material.albedo_color = tint
	material.uv1_triplanar = true
	material.uv1_world_triplanar = true
	var scale := 1.0 / maxf(tile_m, 0.01)
	material.uv1_scale = Vector3(scale, scale, scale)
	material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	material.roughness = 0.95
	material.metallic = 0.0
	return material


static func get_texture(texture_name: String) -> Texture2D:
	if _textures.has(texture_name):
		return _textures[texture_name] as Texture2D
	var path := "%s/%s.png" % [TEXTURE_DIR, texture_name]
	var texture: Texture2D = null
	if ResourceLoader.exists(path):
		texture = load(path) as Texture2D
	else:
		push_warning("EnvironmentMaterials: missing texture %s (run tools/generate_textures.py)" % path)
	_textures[texture_name] = texture
	return texture


static func apply_explore_room(room: Node3D, area_id: String) -> void:
	var theme := get_area_theme(area_id)
	var floor_mesh := room.get_node_or_null("Floor/FloorMesh") as MeshInstance3D
	if floor_mesh != null and not _has_own_material(floor_mesh):
		floor_mesh.material_override = world_material(theme.floor_texture, theme.floor_tint, DEFAULT_FLOOR_TILE)
	for child: Node in room.get_children():
		if not str(child.name).begins_with("Wall"):
			continue
		var wall_mesh := child.get_node_or_null("WallMesh") as MeshInstance3D
		if wall_mesh != null and not _has_own_material(wall_mesh):
			wall_mesh.material_override = world_material(theme.wall_texture, theme.wall_tint, DEFAULT_WALL_TILE)


static func create_pickup_material() -> StandardMaterial3D:
	var material := world_material("sackcloth", Color(0.85, 0.8, 0.72), 0.4)
	material.emission_enabled = true
	material.emission = Color(0.89, 0.63, 0.35)
	material.emission_energy_multiplier = 0.06
	return material


static func create_closet_material() -> StandardMaterial3D:
	return world_material("boards", Color(0.95, 0.92, 0.88), 1.2)


static func get_area_theme(area_id: String) -> AreaTheme:
	var theme := AreaTheme.new()
	match area_id:
		"adjacent_room":
			theme.floor_texture = "flagstone"
			theme.wall_texture = "rubble"
		_:
			pass
	return theme


static func _has_own_material(mesh: MeshInstance3D) -> bool:
	if mesh.material_override != null:
		return true
	return mesh.mesh != null and mesh.mesh.get_surface_count() > 0 and mesh.get_surface_override_material(0) != null
